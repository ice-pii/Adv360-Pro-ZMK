#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#undef CONFIG_ZMK_MACRO_DEFAULT_WAIT_MS

#define CONFIG_ZMK_MACRO_DEFAULT_WAIT_MS 10

#undef CONFIG_ZMK_MACRO_DEFAULT_TAP_MS

#define CONFIG_ZMK_MACRO_DEFAULT_TAP_MS 20

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        m_an: m_axn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp X>;
            label = "M_AXN";
        };

        m_in: m_ixn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp X>;
            label = "M_IXN";
        };

        m_un: m_uxn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U &kp X>;
            label = "M_UXN";
        };

        m_en: m_exn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp X>;
            label = "M_EXN";
        };

        m_on: m_oxn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp X>;
            label = "M_OXN";
        };

        m_UUU: m_UUU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F10 &kp F10>;
            label = "M_UUU";
        };

        m_Ull: m_Ull {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F10 &kp F10 &kp F10>;
            label = "M_ULL";
        };

        m_qn: m_qn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp X>;
            label = "M_QN";
        };

        m_jn: m_jn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp J &kp X>;
            label = "M_JN";
        };

        m_wn: m_wn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp X>;
            label = "M_WN";
        };

        m_vn: m_vn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp X>;
            label = "M_VN";
        };

        m_gn: m_gn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp X>;
            label = "M_GN";
        };

        m_yn: m_yn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp X>;
            label = "M_YN";
        };

        m_pn: m_pn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp X>;
            label = "M_PN";
        };

        m_mn: m_n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp X>;
            label = "M_N";
        };

        m_sin: m_sin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp I &kp X>;
            label = "M_SIN";
        };

        m_jin: m_jin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp J &kp I &kp X>;
            label = "M_JIN";
        };

        m__n: m__n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp X>;
            label = "M__N";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Base";
            bindings = <
&kp ESCAPE        &kp NUMBER_6             &kp NUMBER_4  &kp NUMBER_2             &kp NUMBER_0  &kp NUMBER_8    &sl 6                                                                                                                        &none      &kp NUMBER_7  &kp NUMBER_9  &kp NUMBER_1  &kp NUMBER_3  &kp NUMBER_5   &sk RIGHT_GUI
&none             &kp Q                    &kp J         &kp E                    &kp W         &sk LEFT_SHIFT  &none                                                                                                                        &none      &kp F         &kp G         &kp K         &kp Y         &kp P          &none
&none             &kp A                    &kp S         &kp O                    &kp U         &kp C           &none        &mt LEFT_ALT QUESTION  &kp LANGUAGE_2                  &kp LANGUAGE_1                &mt RIGHT_ALT EXCLAMATION  &none      &kp D         &kp T         &kp N         &kp I         &kp H          &none
&kp LEFT_CONTROL  &kp LS(INTERNATIONAL_3)  &kp X         &kp LS(INTERNATIONAL_1)  &kp V         &kp PLUS                                            &mt LEFT_SHIFT MINUS            &mt RIGHT_CONTROL SLASH                                             &kp L         &kp M         &kp R         &kp Z         &kp B          &kp RIGHT_SHIFT
&kp LEFT_SHIFT    &kp LEFT_ALT             &kp LC(X)     &kp LC(C)                &kp LC(V)                     &lt 4 COMMA  &lt 2 SPACE            &mt LEFT_CONTROL SEMICOLON      &mt RIGHT_SHIFT SINGLE_QUOTE  &lt 1 SPACE                &lt 3 DOT                &none         &none         &none         &kp RIGHT_ALT  &kp RIGHT_CONTROL
            >;
        };

        xn {
            label = "Xn";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &to 0                                          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &m_qn   &m_jn   &m_en   &m_wn   &trans  &trans                                         &trans  &trans  &m_gn   &trans  &m_yn   &m_pn   &trans
&trans  &m_an   &m_in   &m_on   &m_un   &trans  &trans  &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans  &kp S   &trans  &trans
&trans  &trans  &m_sin  &trans  &trans  &trans                     &m__n       &trans                  &trans  &trans  &trans  &m_jin  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &kp SPACE  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        keypad {
            label = "Kp";
            bindings = <
&trans  &trans            &trans               &trans   &trans               &trans            &to 0                                                                     &trans  &trans         &trans          &trans          &trans           &trans         &trans
&trans  &none             &kp LANGUAGE_2       &m_UUU   &kp LANGUAGE_1       &kp LS(CAPSLOCK)  &trans                                                                    &trans  &kp PAGE_UP    &kp HOME        &kp UP_ARROW    &kp END          &kp PAGE_DOWN  &trans
&trans  &kp LEFT_CONTROL  &kp INTERNATIONAL_5  &m_Ull   &kp INTERNATIONAL_4  &none             &trans  &trans       &trans                          &trans  &kp RS(TAB)  &trans  &kp BACKSPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp DELETE     &trans
&trans  &kp LEFT_SHIFT    &kp F6               &kp F10  &kp F7               &none                                  &mt LEFT_SHIFT MINUS            &trans                       &none          &kp ENTER       &none           &none            &kp INSERT     &trans
&trans  &trans            &none                &kp F9   &kp F8                                 &trans  &lt 2 SPACE  &mt LEFT_CONTROL SEMICOLON      &trans  &kp TAB      &trans                 &trans          &trans          &trans           &trans         &trans
            >;
        };

        symbols {
            label = "Symbols";
            bindings = <
&trans  &trans                   &trans         &trans                   &trans               &trans        &to 0                                                          &trans  &trans           &trans                &trans             &trans            &trans            &trans
&trans  &kp LEFT_BRACE           &kp AT_SIGN    &kp LS(MINUS)            &kp RIGHT_BRACKET    &kp EQUAL     &trans                                                         &trans  &kp DOLLAR       &kp BACKSLASH         &kp HASH           &kp AMPERSAND     &kp LEFT_BRACKET  &trans
&trans  &kp SEMICOLON            &kp LESS_THAN  &kp RIGHT_BRACE          &kp ASTERISK         &kp QUESTION  &trans  &trans  &trans      &trans  &mt RIGHT_ALT EXCLAMATION  &trans  &kp EXCLAMATION  &kp LEFT_PARENTHESIS  &kp PIPE           &kp GREATER_THAN  &kp SINGLE_QUOTE  &trans
&trans  &kp LS(INTERNATIONAL_3)  &kp MINUS      &kp LS(INTERNATIONAL_1)  &kp INTERNATIONAL_1  &kp PLUS                      &trans      &trans                                     &kp PERCENT      &kp SLASH             &kp DOUBLE_QUOTES  &kp COLON         &kp CARET         &trans
&trans  &trans                   &none          &none                    &none                              &trans  &trans  &trans      &trans  &lt 1 SPACE                &trans                   &trans                &trans             &trans            &trans            &trans
            >;
        };

        num_fn {
            label = "Num_Fn";
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans        &to 0                                       &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &kp F6        &kp F4        &kp F12       &kp F10       &kp F8        &trans                                      &trans  &kp F7        &kp F9        &kp F11       &kp F3        &kp F5        &trans
&trans  &kp NUMBER_6  &kp NUMBER_4  &kp NUMBER_2  &kp NUMBER_0  &kp NUMBER_8  &trans  &trans  &trans      &trans  &trans  &trans  &kp NUMBER_7  &kp NUMBER_9  &kp NUMBER_1  &kp NUMBER_3  &kp NUMBER_5  &trans
&trans  &trans        &trans        &kp F2        &trans        &trans                        &trans      &trans                  &trans        &trans        &kp F1        &trans        &trans        &trans
&trans  &trans        &trans        &trans        &trans                      &trans  &trans  &trans      &trans  &trans  &trans                &trans        &trans        &trans        &trans        &trans
            >;
        };

        mod {
            label = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 0                                                  &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        hub {
            label = "Hub";
            bindings = <
&none  &to 7  &none  &none  &none  &none  &to 0                                  &to 5  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };

        minecraft {
            label = "MineCraft";
            bindings = <
&kp ESCAPE  &kp F2        &kp F1        &none         &kp F5        &kp F11       &to 0                                                     &none  &none  &none  &none  &none  &none  &none
&kp TAB     &none         &none         &kp W         &none         &none         &kp LC(Q)                                                 &none  &none  &none  &none  &none  &none  &none
&none       &kp E         &kp A         &kp S         &kp D         &kp F         &none      &kp L      &kp LEFT_ALT          &none  &none  &none  &none  &none  &none  &none  &none  &none
&none       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                        &kp LEFT_CONTROL      &none                &none  &none  &none  &none  &none  &none
&none       &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9                &kp F3     &kp SPACE  &kp LEFT_SHIFT        &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };
    };
};
