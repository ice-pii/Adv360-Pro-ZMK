#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        m_axn: m_axn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp X &kp N>;
            label = "M_AXN";
        };

        m_ixn: m_ixn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp X &kp N>;
            label = "M_IXN";
        };

        m_uxn: m_uxn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U &kp X &kp N>;
            label = "M_UXN";
        };

        m_exn: m_exn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp X &kp N>;
            label = "M_EXN";
        };

        m_oxn: m_oxn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp X &kp N>;
            label = "M_OXN";
        };

        m_ya: m_ya {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp A>;
            label = "M_YA";
        };

        m_yaxn: m_yaxn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp A &kp X &kp N>;
            label = "M_YAXN";
        };

        m_yi: m_yi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp I>;
            label = "M_YI";
        };

        m_yixn: m_yixn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp I &kp X &kp N>;
            label = "M_YIXN";
        };

        m_yu: m_yu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp U>;
            label = "M_YU";
        };

        m_yuxn: m_yuxn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp U &kp X &kp N>;
            label = "M_YUXN";
        };

        m_ye: m_ye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp E>;
            label = "M_YE";
        };

        m_yexn: m_yexn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp E &kp X &kp N>;
            label = "M_YEXN";
        };

        m_yo: m_yo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp O>;
            label = "M_YO";
        };

        m_yoxn: m_yoxn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp O &kp X &kp N>;
            label = "M_YOXN";
        };

        m_ou: m_ou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp U>;
            label = "M_OU";
        };

        m_you: m_you {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp O &kp U>;
            label = "M_YOU";
        };

        m_youxn: m_youxn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp O &kp U &kp X &kp N>;
            label = "M_YOUXN";
        };

        m_xn: m_xn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X &kp N>;
            label = "M_XN";
        };

        m__xn: m__xn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp X &kp N>;
            label = "M__XN";
        };

        m_UUU: m_UUU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F10 &kp F10>;
            label = "M_UUU";
        };

        m_Ull: m_Ull {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F10 &kp F10 &kp F10>;
            label = "M_ULL";
        };

        m_uu: m_uu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U &kp U>;
            label = "M_UU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &none  &none  &m_uu  &none  &none           &sl 8                                                                                                    &none      &none  &none  &none  &none    &none  &none
&kp LEFT_GUI      &kp Q  &kp Z  &kp U  &m_ou  &none           &none                                                                                                    &none      &kp F  &kp G  &kp K  &kp J    &kp P  &kp RIGHT_GUI
&kp TAB           &kp A  &kp S  &kp E  &kp O  &kp LS(INT_RO)  &none        &kp LANGUAGE_2  &kp LEFT_ALT                  &kp RIGHT_ALT                 &kp LANGUAGE_1  &none      &kp D  &kp T  &kp N  &kp I    &kp H  &none
&kp LEFT_CONTROL  &kp X  &kp V  &kp C  &kp L  &kp INT_RO                                   &mt LEFT_CONTROL MINUS        &mt RIGHT_CONTROL SLASH                                  &none  &kp M  &kp R  &kp Y    &kp B  &kp RIGHT_CONTROL
&kp LEFT_SHIFT    &none  &none  &none  &none                  &lt 6 COMMA  &lt 2 SPACE     &mt LEFT_SHIFT SEMICOLON      &mt RIGHT_SHIFT SINGLE_QUOTE  &lt 1 SPACE     &lt 4 DOT         &kp W  &none  &lt 6 Y  &none  &kp RIGHT_SHIFT
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans            &trans  &trans  &trans  &trans  &trans  &to 0                                                               &trans   &trans            &trans          &kp PAGE_UP     &trans           &trans          &trans
&trans            &trans  &trans  &m_uxn  &trans  &trans  &trans                                                              &trans   &kp INT_MUHENKAN  &kp HOME        &kp UP_ARROW    &kp END          &kp INT_HENKAN  &trans
&kp LS(CAPSLOCK)  &m_axn  &m_ixn  &m_exn  &m_oxn  &trans  &trans     &trans   &trans             &trans            &trans     &trans   &kp BACKSPACE     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp DELETE      &trans
&trans            &trans  &trans  &m_xn   &m__xn  &trans                      &kp MINUS          &kp SLASH                             &trans            &kp ENTER       &kp PAGE_DOWN   &mo 7            &kp INSERT      &trans
&trans            &trans  &trans  &trans  &trans          &kp COMMA  &kp TAB  &kp SEMICOLON      &kp SINGLE_QUOTE  &kp SPACE  &kp DOT                    &kp F10         &m_UUU          &m_Ull           &trans          &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &kp F11          &kp F12        &kp F13           &kp F14       &kp F15       &to 0                                                                 &trans   &kp F16        &kp F17       &kp F18       &kp F19       &kp F20            &trans
&trans  &kp F1           &kp F2         &kp F3            &kp F4        &kp F5        &trans                                                                &trans   &kp F6         &kp F7        &kp F8        &kp F9        &kp F10            &trans
&trans  &kp NUMBER_1     &kp NUMBER_2   &kp NUMBER_3      &kp NUMBER_4  &kp NUMBER_5  &trans     &trans     &trans             &trans            &trans     &trans   &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0       &trans
&trans  &kp LS(INT_YEN)  &kp AMPERSAND  &kp LEFT_BRACKET  &kp PERCENT   &kp SLASH                           &kp MINUS          &kp SLASH                             &kp LS(MINUS)  &kp COLON     &kp COMMA     &kp DOT       &kp DOUBLE_QUOTES  &trans
&trans  &kp F21          &kp F22        &kp F23           &kp F24                     &kp COMMA  &kp SPACE  &kp SEMICOLON      &kp SINGLE_QUOTE  &kp SPACE  &kp DOT                 &trans        &trans        &trans        &trans             &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 0                                                    &trans           &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &bootloader                                              &bootloader      &trans  &trans      &trans      &trans  &trans  &trans
&studio_unlock  &trans        &trans        &trans        &trans        &trans        &trans       &trans  &trans      &bt BT_CLR  &trans      &stp STP_BAT     &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &macro_ver    &trans                             &trans      &trans                                   &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                      &trans       &trans  &trans      &trans      &bl BL_TOG  &rgb_ug RGB_TOG          &bl BL_INC  &bl BL_DEC  &trans  &trans  &trans
            >;
        };

        symbols {
            display-name = "Red";
            label = "Symbols";
            bindings = <
&trans  &trans           &trans          &trans            &trans       &trans          &to 0                                                                 &trans   &trans         &trans             &trans           &trans                &trans             &trans
&trans  &kp QUESTION     &kp LEFT_BRACE  &kp PLUS          &kp EQUAL    &trans          &trans                                                                &trans   &trans         &kp LT             &kp RIGHT_BRACE  &kp PIPE              &kp GT             &trans
&trans  &kp EXCLAMATION  &kp AT          &kp HASH          &kp DOLLAR   &kp LS(INT_RO)  &trans     &trans     &trans             &trans            &trans     &trans   &kp CARET      &kp RIGHT_BRACKET  &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp BACKSLASH      &trans
&trans  &kp LS(INT_YEN)  &kp AMPERSAND   &kp LEFT_BRACKET  &kp PERCENT  &kp SLASH                             &kp MINUS          &kp SLASH                             &kp LS(MINUS)  &kp COLON          &kp COMMA        &kp DOT               &kp DOUBLE_QUOTES  &trans
&trans  &trans           &trans          &trans            &trans                       &kp COMMA  &kp SPACE  &kp SEMICOLON      &kp SINGLE_QUOTE  &kp SPACE  &kp DOT                 &trans             &trans           &trans                &trans             &trans
            >;
        };

        test {
            display-name = "Purple";
            label = "Test";
            bindings = <
&trans  &kp INT1   &kp INT2   &kp INT3   &kp INT4   &kp INT5   &to 0                                       &trans  &kp INT6   &kp INT7   &kp INT8   &kp INT9   &trans  &trans
&trans  &kp LANG1  &kp LANG2  &kp LANG3  &kp LANG4  &kp LANG5  &trans                                      &trans  &kp LANG6  &kp LANG7  &kp LANG8  &kp LANG9  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans      &trans  &trans  &trans  &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                     &trans      &trans                  &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans     &trans     &trans     &trans                &trans  &trans  &trans      &trans  &trans  &trans             &trans     &trans     &trans     &trans  &trans
            >;
        };

        ya {
            display-name = "Cyan";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &to 0                                       &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &m_yu   &m_you  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &m_ya   &m_yi   &m_ye   &m_yo   &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &mo 7   &trans          &trans  &trans  &trans  &trans  &trans
            >;

            label = "Ya";
        };

        yaxn {
            display-name = "Yellow";
            bindings = <
&trans  &trans   &trans   &trans   &trans    &trans  &to 0                                       &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &m_yuxn  &m_youxn  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &m_yaxn  &m_yixn  &m_yexn  &m_yoxn   &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans   &trans    &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans   &trans            &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            label = "YaXn";
        };

        hub {
            bindings = <
&none  &to 9  &none  &none  &none  &none  &to 0                                  &to 3  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none  &none  &none  &none  &none
            >;

            label = "Hub";
        };

        minecraft {
            bindings = <
&kp ESCAPE  &kp F2        &kp F1        &none         &kp F5        &kp F11       &to 0                                                  &none  &none  &none  &none  &none  &none  &none
&none       &kp LC(Q)     &none         &kp W         &none         &kp LA(TAB)   &none                                                  &none  &none  &none  &none  &none  &none  &none
&none       &kp E         &kp A         &kp S         &kp D         &kp F         &none   &kp L      &none                 &none  &none  &none  &none  &none  &none  &none  &none  &none
&none       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                     &kp LEFT_CONTROL      &none                &none  &none  &none  &none  &none  &none
&none       &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9                &kp F3  &kp SPACE  &kp LEFT_SHIFT        &none  &none  &none         &none  &none  &none  &none  &none
            >;

            label = "MineCraft";
        };
    };
};
